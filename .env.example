# FinCore OS Environment Configuration
# Use this as a template for local development

# ------------------------------------------------------------------------------
# 🔐 IDENTITY & AUTH
# ------------------------------------------------------------------------------
IDENTITY_HTTP_ADDR=:8084
IDENTITY_GRPC_ADDR=:50056
AUTH_ISSUER=http://localhost:8084
AUTH_JWKS_URL=http://localhost:8084/.well-known/jwks.json
IDENTITY_DB_DSN=postgres://fincore:fincore@localhost:5432/identity?sslmode=disable

# ------------------------------------------------------------------------------
# 📡 API GATEWAY
# ------------------------------------------------------------------------------
GATEWAY_HTTP_ADDR=:8080
GATEWAY_PUBLIC_PATH_PREFIXES=/.well-known,/oauth/,/v1/auth/register,/v1/auth/login
ENABLE_CHAOS=false

# ------------------------------------------------------------------------------
# 🏗️ MICROSERVICES ADDR
# ------------------------------------------------------------------------------
ACCOUNT_GRPC_ADDR=localhost:50051
LEDGER_LISTEN_ADDR=localhost:50053
PAYMENT_GRPC_ADDR=localhost:50052
FRAUD_GRPC_ADDR=localhost:50055

# ------------------------------------------------------------------------------
# 🛠️ INFRASTRUCTURE
# ------------------------------------------------------------------------------
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
KAFKA_BROKERS=localhost:9092
TEMPORAL_ADDR=localhost:7233

# ------------------------------------------------------------------------------
# 🛡️ SPIFFE / mTLS
# ------------------------------------------------------------------------------
SPIFFE_MTLS_ENABLED=true
SPIFFE_TRUST_DOMAIN=fincore.local
SPIFFE_WORKLOAD_API_ADDR=unix:///run/spire/sockets/agent.sock
