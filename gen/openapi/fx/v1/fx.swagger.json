            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "baseCurrency",
            "description": "e.g. \"USD\"",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "targetCurrency",
            "description": "e.g. \"EUR\"",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "FXService"
        ]
      }
    }
